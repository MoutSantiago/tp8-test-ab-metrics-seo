# Copia este archivo como `.env` y ajusta los valores antes de levantar.
# Nunca subas `.env` al repositorio (ya está en .gitignore).

POSTGRES_USER=taller_norte
POSTGRES_PASSWORD=tu_contraseña_segura_aqui
POSTGRES_DB=taller_norte_db

# DATABASE_URL se construye automáticamente en docker-compose.
# Define solo si corres la app fuera de Docker.
DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB

NODE_ENV=production
